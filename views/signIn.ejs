<!DOCTYPE html>
<html>
<head>
    <link rel='stylesheet' href='/stylesheets/signIn.css'/>
</head>
<body>
<div class="main">
    <div class="container">
        <h1 id="text">Sign In</h1>

        <form action="/auth/signIn" method="post" class="form">
                <input class="input" name="username" placeholder="Username" type="text">
                <img class="user_icon" src="https://img.icons8.com/ios-glyphs/30/user--v1.png" alt="user icon">
                <input class="input" name="email" placeholder="Email" type="email">
                <img class="email_icon" src="https://img.icons8.com/ios-filled/50/message-squared.png" alt="email icon">
            <input class="input" name="password" placeholder="Password" type="password">
            <button id="submit" type="submit">Create Account</button>
        </form>
    </div>

</div>


</body>
</html>
