<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Weather Forecast</title>
    <link rel="stylesheet" href="stylesheets/chart.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Arial">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" defer></script>
    <script src="/javascripts/chart.js" defer></script>

</head>
<body>


<main id="weatherSection">
    <div class="top-bar">
        <div class="input-wrapper">
            <input type="text" id="cityInput" placeholder="Enter city name">
            <img src="/icons/static/static-search.png" class="search-icon" alt="search">
            <ul id="suggestions"></ul>
        </div>
        <button id="search_btn">Search</button>
    </div>
</main>
<div id="current-container"></div>
<hr>
<div id="forecast-container"></div>
</body>
</html>