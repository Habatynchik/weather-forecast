<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Weather Forecast</title>

    <link rel="stylesheet" href="stylesheets/chart.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" defer></script>
    <script src="/javascripts/chart.js" defer></script>
</head>
<body>

<main id="weatherSection">

    <div class="top-bar">
        <div class="input-wrapper">
            <input type="text" id="cityInput" placeholder="Enter city name" autocomplete="off" />
            <img src="/icons/static/static-search.png" class="search-icon" alt="search" />
            <ul id="suggestions"></ul>
        </div>
        <button id="search_btn">Search</button>
    </div>

    <div id="main-content">
        <div id="forecast-container"></div>

        <div id="outfit-wrapper">
            <div id="base-layer">
                <img src="/icons/outfit/standing-man.png" alt="Base Man" />
            </div>
            <div id="head-layer" class="outfit-layer"></div>
            <div id="top-layer" class="outfit-layer"></div>
            <div id="bottom-layer" class="outfit-layer"></div>
            <div id="shoes-layer" class="outfit-layer"></div>
            <div id="umbrella-layer" class="outfit-layer"></div>
        </div>
    </div>

</main>

</body>
</html>