<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Історія запитів</title>
    <link rel="stylesheet" href="/stylesheets/history.css">
    <script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.7.1.js" defer></script>
    <script src="javascripts/index.js" defer></script>
</head>
<body>
<header>

    <button id="burger-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="white" class="bi bi-list" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
        </svg>
    </button>

    <div class="profile" id="profileBtn" tabindex="0" aria-haspopup="true" aria-expanded="false">
        <div class="logo"><%= firstLetter %></div>
        <div class="nickname"><%= username %></div>
    </div>
    <!-- <nav class="burger-menu" id="burgerMenu" role="menu" aria-label="Profile menu">
        <a href="#" role="menuitem" id="historyLink">History</a>
        <a href="#" role="menuitem" id="logoutLink">Log out</a>
    </nav> -->
</header>


<!-- WEATHER SECTION -->
<main id="weatherSection">

    <div class="burger-menu">
        <form class="form" action="" method="get">
            <button class="submit_btn" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
                    <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.081-.51l.993.123a8 8 0 0 1-.23 1.155l-.964-.267q.069-.247.12-.501m-.952 2.379q.276-.436.486-.908l.914.405q-.24.54-.555 1.038zm-.964 1.205q.183-.183.35-.378l.758.653a8 8 0 0 1-.401.432z"/>
                    <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0z"/>
                    <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5"/>
                </svg>
                <p>History</p>
            </button>
        </form>

        <form class="form" action="/logout" method="get">
            <button class="submit_btn" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-left" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M6 12.5a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-8a.5.5 0 0 0-.5.5v2a.5.5 0 0 1-1 0v-2A1.5 1.5 0 0 1 6.5 2h8A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 5 12.5v-2a.5.5 0 0 1 1 0z"/>
                    <path fill-rule="evenodd" d="M.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L1.707 7.5H10.5a.5.5 0 0 1 0 1H1.707l2.147 2.146a.5.5 0 0 1-.708.708z"/>
                </svg>
                <p>Log out</p>
            </button>

        </form>

        <form class="form" action="/auth/signIn" method="get">
            <button class="submit_btn" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-in-right" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z"/>
                    <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                </svg>
                <p>Sign In</p>
            </button>
        </form>

        <form class="form" action="/auth/signUp" method="get">
            <button class="submit_btn" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                </svg>
                <p>Sign Up</p>
            </button>
        </form>

        <div class="favourite">
            <!-- <div class="item">
                <div class="part1">
                    <p>Kyiv</p>
                    <img src="/icons/icons8-cloud.gif" alt="">
                </div>
                <div class="part2">
                    <div class="top2">
                        <p>16 C</p>
                        <svg id="svg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                            <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                        </svg>
                    </div>
                    <div class="bottom2">
                        <p>wind speed: 3.74</p>
                    </div>
                </div>
            </div> -->



            <% weatherResults.forEach(function(e) { %>
                <form action="/delete" method="post" class="item">
                    <div class="part1">
                        <p><%= e.name %></p>
                        <input type="hidden" name="city" value="<%= e.name %>">
                        <img style="width: 55px; height: 55px;" src="https://openweathermap.org/img/wn/<%=e.weather[0].icon%>@2x.png" alt="<%= e.weather[0].description %>">
                    </div>
                    <div class="part2">
                        <div class="top2">
                            <p><%= e.main.temp %> °C </p>
                            <button class="star" type="submit">
                                <svg id="svg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                                    <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                                </svg>
                            </button>
                        </div>
                        <div class="bottom2">
                            <p>wind speed: <%= e.wind.speed %></p>
                        </div>
                    </div>
                </form>
            <% }); %>
        </div>

    </div>


    <table class="history_table">
        <thead class="table_header">
        <tr>
            <th class="header_item">Дата</th>
            <th class="header_item">Місто</th>
            <th class="header_item">Температура (°C)</th>
            <th class="header_item">Вологість (%)</th>
            <th class="header_item">Швидкість вітру (м/с)</th>
        </tr>
        </thead>
        <tbody>
        <% queries.forEach(query => { %>
            <tr class="table_row">
                <td class="table_item category"><%= query.date %></td>
                <td class="table_item"><%= query.city %></td>
                <td class="table_item"><%= query.temp %></td>
                <td class="table_item"><%= query.humidity %></td>
                <td class="table_item"><%= query.wind_speed %></td>
            </tr>
        <% }) %>
        </tbody>
    </table>

</main>


</body>
</html>